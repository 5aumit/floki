/*
   Floki uses only the six One Dark tokens from the approved visual brief:
   Night #282c34, Fog #abb2bf, Signal blue #61afef, Evidence green #98c379,
   Work amber #e5c07b, and Fault red #e06c75.
*/

Screen {
    layout: vertical;
    background: #282c34;
    color: #abb2bf;
}

#floki-welcome {
    height: auto;
    padding: 1 2;
    background: #282c34;
    border-bottom: solid #61afef;
    color: #abb2bf;
}

#chat-view {
    height: 1fr;
    min-height: 0;
    background: #282c34;
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-gutter: stable;
}

#command-deck {
    height: auto;
    padding: 0 1;
    background: #282c34;
    border-top: solid #abb2bf 35%;
}

#query-input {
    width: 100%;
    margin: 1 0 0 0;
    background: #282c34;
    color: #abb2bf;
    border: solid #abb2bf 35%;
}

#query-input:focus {
    border: solid #61afef;
}

#query-input.-disabled {
    color: #abb2bf 55%;
    border: solid #abb2bf 20%;
}

#status-bar,
#key-help {
    width: 100%;
    height: 1;
    color: #abb2bf 70%;
    background: #282c34;
    overflow: hidden;
    text-overflow: ellipsis;
}

#status-bar {
    margin: 1 0 0 0;
}

#key-help {
    margin: 0 0 1 0;
}

QueryLoading {
    width: 78%;
    height: 1;
    margin: 1 1 0 1;
    color: #e5c07b;
}

UserPrompt {
    width: 72%;
    height: auto;
    offset-x: 27%;
    margin: 1 0 0 0;
    padding: 0 1;
    color: #abb2bf;
    background: #282c34;
    border-right: solid #61afef;
}

AssistantResponse {
    width: 78%;
    height: auto;
    margin: 1 1 1 1;
    padding: 0 1 1 1;
    color: #abb2bf;
    background: #282c34;
    border-left: solid #98c379;
}

FlokiLabel {
    width: auto;
    height: 1;
    margin: 0 0 0 0;
    color: #98c379;
    text-style: bold;
}

SystemNotice {
    width: 78%;
    height: auto;
    margin: 1 1 1 1;
    padding: 0 1;
    color: #e06c75;
    background: #282c34;
    border-left: solid #e06c75;
}

AssistantResponse SystemNotice {
    width: 100%;
    margin: 1 0 0 0;
}

Markdown,
StaticBlock {
    width: 100%;
    height: auto;
    margin: 0;
    color: #abb2bf;
}

AssistantResponse Markdown {
    overflow-x: auto;
    overflow-y: hidden;
}

HorizontalScroll.table-scroll {
    width: 100%;
    height: auto;
    margin: 0;
    overflow-x: auto;
    overflow-y: hidden;
}

Screen.narrow #floki-welcome,
Screen.compact #floki-welcome {
    height: auto;
    padding: 0 1;
}

Screen.narrow UserPrompt,
Screen.narrow AssistantResponse,
Screen.narrow SystemNotice,
Screen.narrow QueryLoading,
Screen.compact UserPrompt,
Screen.compact AssistantResponse,
Screen.compact SystemNotice,
Screen.compact QueryLoading {
    width: 96%;
}

Screen.narrow UserPrompt,
Screen.compact UserPrompt {
    offset-x: 3%;
}

Screen.compact #command-deck {
    padding: 0;
}

Screen.compact #query-input {
    margin: 0;
}
